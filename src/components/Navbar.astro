---
import { nav, site } from "../data/site";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 border-b border-line bg-canvas">
  <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
    <a href="/" class="group flex items-baseline gap-3" aria-label={`${site.name} — home`}>
      <span class="font-mono text-sm tracking-[0.2em] text-mint">SS</span>
      <span class="hidden flex-col leading-tight sm:flex">
        <span class="font-display text-sm font-medium tracking-tight text-ink">{site.name}</span>
        <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">{site.role}</span>
      </span>
    </a>

    <!-- Full nav appears at xl; below that the disclosure menu takes over. -->
    <nav aria-label="Primary" class="hidden xl:block">
      <ul class="flex items-center gap-5">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "relative py-1 font-mono text-[11px] uppercase tracking-[0.14em] transition-colors",
                isActive(item.href)
                  ? "text-mint after:absolute after:-bottom-0.5 after:left-0 after:h-px after:w-full after:bg-mint"
                  : "text-muted hover:text-ink",
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="mobile-nav"
      class="-mr-2 inline-flex h-10 w-10 items-center justify-center border border-line text-muted transition-colors hover:border-mint hover:text-mint xl:hidden"
    >
      <span class="sr-only">Toggle navigation</span>
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M2 5h14M2 9h14M2 13h14" />
      </svg>
    </button>
  </div>

  <div id="mobile-nav" data-nav-panel class="hidden border-t border-line bg-surface xl:hidden">
    <nav aria-label="Mobile" class="mx-auto w-full max-w-6xl px-5 py-2 sm:px-8">
      <ul class="divide-y divide-line/70">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class:list={[
                "flex items-center justify-between py-3 font-mono text-xs uppercase tracking-[0.16em]",
                isActive(item.href) ? "text-mint" : "text-muted hover:text-ink",
              ]}
            >
              {item.label}
              {isActive(item.href) && <span class="h-1 w-1 bg-mint" aria-hidden="true" />}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-nav-panel]");

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      panel.classList.toggle("hidden", !open);
    };

    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true"),
    );
    panel.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
  }
</script>
