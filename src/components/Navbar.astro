---
import { nav, site } from "../data/site";

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-50 px-3 pt-3 sm:px-5">
  <div class="mx-auto w-full max-w-6xl">
    <div class="flex h-14 items-center justify-between gap-3 rounded-2xl border border-white/10 bg-[#070b14]/80 py-2 pl-3 pr-2 shadow-[0_18px_50px_-24px_rgba(0,0,0,0.95)] backdrop-blur-xl sm:pl-4">
      <a href="/" class="group flex shrink-0 items-center gap-2.5" aria-label={`${site.name} — home`}>
        <span
          class="grid h-9 w-9 place-items-center rounded-xl border border-mint/25 bg-linear-to-br from-mint/20 to-azure/5 font-display text-[11px] font-semibold tracking-[0.12em] text-mint transition-transform duration-300 group-hover:scale-105"
        >
          SS
        </span>
        <span class="hidden flex-col leading-none sm:flex">
          <span class="font-display text-[13px] font-medium tracking-tight text-ink">{site.name}</span>
          <span class="mt-1 font-mono text-[9px] uppercase tracking-[0.18em] text-faint">{site.role}</span>
        </span>
      </a>

      <nav aria-label="Primary" class="hidden xl:block">
        <ul class="flex items-center gap-1">
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "inline-flex rounded-full px-3.5 py-2 text-[12px] transition-colors duration-200",
                  isActive(item.href)
                    ? "bg-white/10 text-ink"
                    : "text-muted hover:bg-white/5 hover:text-ink",
                ]}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex shrink-0 items-center gap-2">
        <a
          href="/contact"
          class="hidden items-center gap-1.5 rounded-full bg-linear-to-r from-mint to-azure px-4 py-2 font-mono text-[10px] font-medium uppercase tracking-[0.14em] text-[#04100f] transition-opacity hover:opacity-90 sm:inline-flex"
        >
          Let's talk
          <span aria-hidden="true">↗</span>
        </a>

        <button
          type="button"
          data-nav-toggle
          aria-expanded="false"
          aria-controls="mobile-nav"
          class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-line text-muted transition-colors hover:border-mint/40 hover:text-ink xl:hidden"
        >
          <span class="sr-only">Toggle navigation</span>
          <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M2 5h14M2 9h14M2 13h14" />
          </svg>
        </button>
      </div>
    </div>

    <div id="mobile-nav" data-nav-panel class="mt-2 hidden overflow-hidden rounded-2xl border border-white/10 bg-[#070b14]/95 backdrop-blur-xl xl:hidden">
      <nav aria-label="Mobile" class="p-2">
        <ul class="grid gap-0.5">
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class:list={[
                  "flex items-center justify-between rounded-xl px-4 py-3 text-sm transition-colors",
                  isActive(item.href)
                    ? "bg-white/5 text-mint"
                    : "text-muted hover:bg-white/5 hover:text-ink",
                ]}
              >
                {item.label}
                {isActive(item.href) && <span class="h-1.5 w-1.5 rounded-full bg-mint" aria-hidden="true" />}
              </a>
            </li>
          ))}
        </ul>
        <a
          href="/contact"
          class="mt-2 flex items-center justify-center gap-2 rounded-xl bg-linear-to-r from-mint to-azure px-4 py-3 font-mono text-[10px] font-medium uppercase tracking-[0.14em] text-[#04100f]"
        >
          Let's talk ↗
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-nav-panel]");

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      panel.classList.toggle("hidden", !open);
    };

    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true"),
    );
    panel.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
  }
</script>
