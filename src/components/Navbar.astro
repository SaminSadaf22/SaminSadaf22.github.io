---
import { nav, site } from "../data/site";
---

<header data-site-chrome class="sticky top-0 z-50 px-3 pt-3 sm:px-5">
  <div class="mx-auto w-full max-w-6xl">
    <div
      class="flex h-14 items-center justify-between gap-3 rounded-2xl border border-white/10 bg-[#070b14]/80 py-2 pl-3 pr-2 shadow-[0_18px_50px_-24px_rgba(0,0,0,0.95)] backdrop-blur-xl sm:pl-4"
    >
      <a href="/#top" class="group flex shrink-0 items-center gap-2.5" aria-label={`${site.name} — home`}>
        <span
          class="grid h-9 w-9 place-items-center rounded-xl border border-mint/25 bg-linear-to-br from-mint/20 to-azure/5 font-display text-[11px] font-semibold tracking-[0.12em] text-mint transition-transform duration-300 group-hover:scale-105"
        >
          SS
        </span>
        <span class="hidden flex-col leading-none sm:flex">
          <span class="font-display text-[13px] font-medium tracking-tight text-ink">{site.name}</span>
          <span class="mt-1 font-mono text-[9px] uppercase tracking-[0.18em] text-faint">{site.role}</span>
        </span>
      </a>

      <nav aria-label="Primary" class="min-w-0 flex-1 overflow-x-auto" style="scrollbar-width: none; -ms-overflow-style: none;">
        <ul class="flex items-center gap-0.5 whitespace-nowrap">
          {nav.map((item) => (
            <li>
              <a
                href={item.href}
                data-nav-link={item.href}
                class="nav-link inline-flex whitespace-nowrap rounded-full px-2 py-2 text-[10px] text-muted transition-colors duration-200 hover:bg-white/5 hover:text-ink sm:px-3 sm:text-[12px]"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex shrink-0 items-center gap-2">
        <a
          href="/#contact"
          class="hidden items-center gap-1.5 rounded-full bg-linear-to-r from-mint to-azure px-4 py-2 font-mono text-[10px] font-medium uppercase tracking-[0.14em] text-[#04100f] transition-opacity hover:opacity-90 sm:inline-flex"
        >
          Let's talk
          <span aria-hidden="true">↗</span>
        </a>

      </div>
    </div>

  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-nav-panel]");

  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      panel.classList.toggle("hidden", !open);
    };

    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true"),
    );
    panel.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") setOpen(false);
    });
  }

  // On the single-page home, highlight the section currently being read.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"));
  const sectionIds = ["top", "about", "research", "projects", "resume", "terminal", "contact"];

  const setCurrent = (href: string) => {
    links.forEach((link) => {
      const current = link.dataset.navLink === href;
      link.classList.toggle("is-current", current);
      if (current) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
  };

  const path = window.location.pathname.replace(/\/+$/, "") || "/";
  if (path === "/") {
    let ticking = false;

    const updateCurrent = () => {
      const marker = window.scrollY + Math.min(window.innerHeight * 0.35, 280);
      let current = "top";

      for (const id of sectionIds) {
        const element = document.getElementById(id);
        if (!element) continue;
        if (element.getBoundingClientRect().top + window.scrollY <= marker) current = id;
      }

      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 8) {
        current = "contact";
      }

      setCurrent(`/#${current}`);
      ticking = false;
    };

    window.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(updateCurrent);
      },
      { passive: true },
    );
    window.addEventListener("load", updateCurrent);
    updateCurrent();
  }

  // Ctrl/Cmd+K jumps to the terminal, wherever you are.
  document.addEventListener("keydown", (event) => {
    if (!(event.metaKey || event.ctrlKey) || event.key.toLowerCase() !== "k") return;
    event.preventDefault();

    const input = document.getElementById("cli-input") as HTMLInputElement | null;
    if (!input) {
      window.location.assign("/#terminal");
      return;
    }

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.getElementById("terminal")?.scrollIntoView({
      behavior: reduced ? "auto" : "smooth",
      block: "center",
    });
    window.setTimeout(() => input.focus({ preventScroll: true }), reduced ? 0 : 400);
  });
</script>
