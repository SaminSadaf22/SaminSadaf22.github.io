---
import { ArrowUpRight } from "@lucide/astro";
import SectionHeading from "./SectionHeading.astro";
import { resume } from "../data/resume";
import { site } from "../data/site";

const entries = [
  ...resume.education.map((item) => ({
    period: item.period,
    tag: "Education",
    title: item.degree,
    org: `${item.institution} · ${item.location}`,
    body: item.detail,
    tags: [] as string[],
    href: "/education",
    linkLabel: "Education",
  })),
  ...resume.engineering.map((project) => ({
    period: "Earlier",
    tag: "Engineering",
    title: project.title,
    org: project.category,
    body: project.summary,
    tags: project.tags,
    href: project.href,
    linkLabel: "Project",
  })),
];
---

<section id="resume" class="reveal scroll-mt-28 border-t border-white/10 py-16 sm:py-20">
  <SectionHeading
    eyebrow="Resume"
    title="The record, without the padding"
    description="Education and software engineering — the same resume as the printable CV, kept to what can be verified."
    href="/cv"
    linkLabel="Printable CV"
  />

  <div
    class="mt-9 overflow-hidden rounded-3xl border border-white/10 bg-linear-to-b from-white/[0.05] to-white/[0.015] backdrop-blur"
  >
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 px-5 py-4 sm:px-8">
      <div>
        <p class="font-display text-sm font-medium tracking-tight text-ink">{site.name}</p>
        <p class="mt-1 font-mono text-[9px] uppercase tracking-[0.16em] text-faint">
          {site.role} · {site.location}
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <a
          href={`mailto:${site.email}`}
          class="rounded-full border border-line px-3 py-1.5 font-mono text-[9px] uppercase tracking-[0.14em] text-muted transition-colors hover:border-mint/40 hover:text-mint"
        >
          Email
        </a>
        <a
          href="/cv"
          class="inline-flex items-center gap-1.5 rounded-full border border-mint/30 bg-mint/10 px-3 py-1.5 font-mono text-[9px] uppercase tracking-[0.14em] text-mint transition-colors hover:bg-mint/15"
        >
          Print / save PDF
          <ArrowUpRight size={11} strokeWidth={1.75} aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="grid lg:grid-cols-[250px_1fr]">
      <aside class="order-2 border-b border-white/10 p-5 sm:p-7 lg:order-1 lg:border-b-0 lg:border-r">
        <p class="font-mono text-[9px] uppercase tracking-[0.18em] text-faint">Contact</p>
        <ul class="mt-3 space-y-2 text-[12px] leading-relaxed">
          <li>
            <a
              href={`mailto:${site.email}`}
              class="break-all text-muted transition-colors hover:text-mint"
            >
              {site.email}
            </a>
          </li>
          <li>
            <a
              href={`tel:${site.phoneHref}`}
              class="text-muted transition-colors hover:text-mint"
            >
              {site.phone}
            </a>
          </li>
          <li class="text-muted">{site.location}</li>
          <li>
            <a
              href={site.url}
              class="text-muted transition-colors hover:text-mint"
              target="_blank"
              rel="noopener noreferrer"
            >
              {resume.siteUrl} ↗
            </a>
          </li>
        </ul>

        <p class="mt-6 font-mono text-[9px] uppercase tracking-[0.18em] text-faint">Core stack</p>
        <ul class="mt-3 space-y-3">
          {resume.skills.map((group) => (
            <li>
              <p class="font-mono text-[9px] uppercase tracking-[0.14em] text-mint">{group.title}</p>
              <p class="mt-1 text-[11px] leading-relaxed text-muted">{group.items.join(" · ")}</p>
            </li>
          ))}
        </ul>

        <p class="mt-6 font-mono text-[9px] uppercase tracking-[0.18em] text-faint">Publications</p>
        <p class="mt-2 text-[11px] leading-relaxed text-muted">
          None yet. Listed only when a paper exists and can be checked.
        </p>
      </aside>

      <div class="order-1 p-5 sm:p-8 lg:order-2">
        <ol class="relative space-y-7 border-l border-white/10 pl-6">
          {entries.map((entry) => (
            <li class="relative">
              <span
                class="absolute -left-[31px] top-1.5 grid h-3.5 w-3.5 place-items-center rounded-full border border-mint/30 bg-canvas"
                aria-hidden="true"
              >
                <span class="h-1.5 w-1.5 rounded-full bg-mint"></span>
              </span>

              <div class="flex flex-wrap items-center gap-2.5">
                <span class="font-mono text-[9px] uppercase tracking-[0.16em] text-mint">
                  {entry.period}
                </span>
                <span
                  class="rounded-full border border-line px-2 py-0.5 font-mono text-[8px] uppercase tracking-[0.14em] text-faint"
                >
                  {entry.tag}
                </span>
              </div>

              <h3 class="mt-2 font-display text-base font-medium leading-snug tracking-tight text-ink sm:text-lg">
                {entry.title}
              </h3>
              <p class="mt-1 text-[11px] text-faint">{entry.org}</p>
              <p class="mt-2 max-w-xl text-[13px] leading-relaxed text-muted">{entry.body}</p>

              {entry.tags.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {entry.tags.map((tag) => (
                    <span class="rounded-full border border-line px-2 py-0.5 font-mono text-[9px] text-faint">
                      {tag}
                    </span>
                  ))}
                </div>
              )}

              {entry.href && (
                <a
                  href={entry.href}
                  class="mt-3 inline-flex items-center gap-1.5 font-mono text-[9px] uppercase tracking-[0.14em] text-faint transition-colors hover:text-mint"
                >
                  {entry.linkLabel}
                  <ArrowUpRight size={10} strokeWidth={1.75} aria-hidden="true" />
                </a>
              )}
            </li>
          ))}
        </ol>

        <div class="mt-8 flex flex-wrap items-center gap-3 border-t border-white/10 pt-5">
          <a href="/cv" class="btn btn-primary">
            Open the CV
            <ArrowUpRight size={13} strokeWidth={1.75} aria-hidden="true" />
          </a>
          <p class="font-mono text-[9px] uppercase tracking-[0.14em] text-faint">
            Print-tuned · A4 · Save as PDF
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
