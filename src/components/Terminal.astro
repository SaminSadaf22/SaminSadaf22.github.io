---
import { insights } from "../data/cli";
import SectionHeading from "./SectionHeading.astro";

const suggestions = ["thesis", "projects", "skills", "availability", "sudo"];
---

<section id="terminal" class="reveal scroll-mt-28 border-t border-white/10 py-16 sm:py-20">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <SectionHeading
      eyebrow="Terminal"
      title="The short version, searchable"
      description="A small read-only shell over the facts on this site. Type a question, a topic, or help."
    />
    <p class="hidden shrink-0 items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1.5 font-mono text-[10px] uppercase tracking-[0.14em] text-faint sm:inline-flex">
      <span class="h-1.5 w-1.5 rounded-full bg-mint" aria-hidden="true"></span>
      Ctrl K to focus
    </p>
  </div>

  <div
    class="terminal-shell mt-8 overflow-hidden rounded-2xl border border-white/10 bg-[#050910] shadow-[0_40px_100px_-60px_rgba(0,0,0,1)] transition-[border-color,box-shadow] duration-300"
    data-terminal
  >
    <div class="flex items-center gap-2 border-b border-white/10 bg-white/[0.02] px-4 py-2.5">
      <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]/70" aria-hidden="true"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]/70" aria-hidden="true"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]/70" aria-hidden="true"></span>
      <span class="ml-2 truncate font-mono text-[10px] tracking-[0.12em] text-faint">
        samin@portfolio — insights
      </span>
      <span class="ml-auto rounded-full border border-white/10 px-2 py-0.5 font-mono text-[9px] uppercase tracking-[0.14em] text-faint">
        read-only
      </span>
    </div>

    <div
      data-cli-output
      role="log"
      aria-live="polite"
      aria-label="Terminal output"
      class="h-64 overflow-y-auto px-4 py-4 font-mono text-[12px] leading-relaxed sm:h-80 sm:px-5"
    >
    </div>

    <form data-cli-form class="flex items-center gap-2 border-t border-white/10 px-4 py-3 sm:px-5">
      <label for="cli-input" class="shrink-0 font-mono text-[11px] text-mint">
        samin@portfolio<span class="hidden text-faint sm:inline"> ~</span> %
      </label>
      <input
        id="cli-input"
        name="command"
        type="text"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="send"
        placeholder='try "thesis", "skills", or help'
        aria-label="Ask the portfolio terminal"
        class="min-w-0 flex-1 bg-transparent font-mono text-[12px] text-ink outline-none placeholder:text-faint/70 focus-visible:outline-none"
      />
      <button
        type="submit"
        class="grid h-7 w-7 shrink-0 place-items-center rounded-md border border-white/10 font-mono text-[11px] text-muted transition-colors hover:border-mint/40 hover:text-mint"
        aria-label="Run command"
      >
        ↵
      </button>
    </form>
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-2">
    <span class="font-mono text-[9px] uppercase tracking-[0.16em] text-faint">Try</span>
    {suggestions.map((suggestion) => (
      <button
        type="button"
        data-cli-suggest={suggestion}
        class="rounded-full border border-white/10 bg-white/[0.02] px-3 py-1 font-mono text-[10px] tracking-[0.06em] text-muted transition-colors hover:border-mint/40 hover:text-mint"
      >
        {suggestion}
      </button>
    ))}
  </div>

  <!-- Static index for the shell; hidden from people and assistive tech. -->
  <div hidden data-cli-index>
    {insights.map((insight) => (
      <article
        data-insight
        data-id={insight.id}
        data-keywords={insight.keywords.join(" ")}
      >
        <h3 data-title>{insight.title}</h3>
        <p data-body>{insight.body}</p>
        {insight.links && (
          <ul>
            {insight.links.map((link) => (
              <li>
                <a href={link.href} data-link>{link.label}</a>
              </li>
            ))}
          </ul>
        )}
      </article>
    ))}
  </div>
</section>

<script>
  const output = document.querySelector<HTMLElement>("[data-cli-output]");
  const form = document.querySelector<HTMLFormElement>("[data-cli-form]");
  const input = document.getElementById("cli-input") as HTMLInputElement | null;
  const index = document.querySelector<HTMLElement>("[data-cli-index]");
  const shell = document.querySelector<HTMLElement>("[data-terminal]");

  if (output && form && input && index) {
    type Entry = {
      id: string;
      title: string;
      keywords: string;
      body: string;
      links: { label: string; href: string }[];
    };

    const entries: Entry[] = Array.from(index.querySelectorAll<HTMLElement>("[data-insight]")).map(
      (node) => ({
        id: node.dataset.id ?? "",
        title: node.querySelector("[data-title]")?.textContent ?? "",
        keywords: (node.dataset.keywords ?? "").toLowerCase(),
        body: node.querySelector("[data-body]")?.textContent ?? "",
        links: Array.from(node.querySelectorAll<HTMLAnchorElement>("[data-link]")).map((link) => ({
          label: link.textContent ?? "",
          href: link.getAttribute("href") ?? "#",
        })),
      }),
    );

    const history: string[] = [];
    let historyIndex = 0;

    const scrollOutput = () => {
      output.scrollTop = output.scrollHeight;
    };

    const line = (text: string, tone: "muted" | "ink" | "faint" | "mint" = "muted") => {
      const p = document.createElement("p");
      p.className = {
        muted: "text-muted",
        ink: "text-ink",
        faint: "text-faint",
        mint: "text-mint",
      }[tone];
      p.textContent = text;
      output.appendChild(p);
      return p;
    };

    const commandEcho = (command: string) => {
      const p = document.createElement("p");
      p.className = "mt-3 first:mt-0 text-faint";
      const prompt = document.createElement("span");
      prompt.className = "text-mint";
      prompt.textContent = "samin@portfolio % ";
      p.append(prompt, document.createTextNode(command));
      output.appendChild(p);
    };

    const result = (entry: Entry) => {
      const wrap = document.createElement("div");
      wrap.className = "mt-2.5 space-y-1.5 border-l border-mint/20 pl-3";

      const title = document.createElement("p");
      title.className = "font-medium text-ink";
      title.textContent = entry.title;
      wrap.appendChild(title);

      const body = document.createElement("p");
      body.className = "max-w-2xl text-muted";
      body.textContent = entry.body;
      wrap.appendChild(body);

      if (entry.links.length) {
        const links = document.createElement("p");
        links.className = "flex flex-wrap gap-x-4 gap-y-1 pt-0.5";
        entry.links.forEach((link) => {
          const a = document.createElement("a");
          a.href = link.href;
          a.textContent = `${link.label} ↗`;
          a.className = "text-mint underline decoration-mint/30 underline-offset-4 hover:decoration-mint";
          if (/^https?:/.test(link.href)) {
            a.target = "_blank";
            a.rel = "noopener noreferrer";
          }
          links.appendChild(a);
        });
        wrap.appendChild(links);
      }

      output.appendChild(wrap);
    };

    const usage = () => {
      line("Commands:", "ink");
      [
        "help            show this list",
        "ls              list every topic",
        "whoami          one-line identity",
        "search <words>  query the topic index",
        "clear           clear the screen",
        "exit            not happening",
      ].forEach((text) => line(`  ${text}`, "muted"));
      line("Or just ask: \"what did the thesis compare?\"", "faint");
      line("A few not-very-hidden extras: sudo, coffee, rm -rf /", "faint");
    };

    const listTopics = () => {
      line("Topics in the index:", "ink");
      entries.forEach((entry) => line(`  ${entry.id.padEnd(14)} ${entry.title}`, "muted"));
    };

    const score = (entry: Entry, words: string[]) => {
      let points = 0;
      for (const word of words) {
        if (entry.title.toLowerCase().includes(word)) points += 3;
        if (entry.keywords.includes(word)) points += 4;
        if (entry.body.toLowerCase().includes(word)) points += 1;
      }
      return points;
    };

    const search = (query: string) => {
      const words = query
        .toLowerCase()
        .replace(/[^\p{L}\p{N}\s-]/gu, " ")
        .split(/\s+/)
        .filter((word) => word.length > 2 && !["the", "what", "your", "about", "does", "did", "you", "tell", "with", "from"].includes(word));

      if (!words.length) {
        line("Give me a word to search for — try `thesis`, `skills` or `contact`.", "muted");
        return;
      }

      const ranked = entries
        .map((entry) => ({ entry, points: score(entry, words) }))
        .sort((a, b) => b.points - a.points);

      const best = ranked[0];
      if (!best || best.points === 0) {
        line(`No entry for "${query}". Try \`ls\` for topics, or ask about research, projects, skills or contact.`, "muted");
        return;
      }

      result(best.entry);
      const related = ranked
        .slice(1, 3)
        .filter((item) => item.points > 0)
        .map((item) => item.entry.id);
      if (related.length) {
        line(`Related: ${related.join(" · ")}`, "faint");
      }
    };

    const run = (raw: string) => {
      const command = raw.trim();
      if (!command) return;

      commandEcho(command);

      const lower = command.toLowerCase();
      const [head, ...rest] = lower.split(/\s+/);

      if (lower === "clear") {
        output.replaceChildren();
        return;
      }

      if (lower === "help" || lower === "?") {
        usage();
      } else if (lower === "ls" || lower === "topics") {
        listTopics();
      } else if (lower === "whoami") {
        line("samin — AI researcher & builder · Dhaka, Bangladesh", "ink");
        line("BSc in Software Engineering, Daffodil International University (2026).", "muted");
      } else if (lower === "sudo" || head === "sudo") {
        line("Nice try. This shell is read-only — and you are not in the sudoers file.", "muted");
        line("Samin is the only admin here. Try `help` instead.", "faint");
      } else if (lower === "coffee" || lower === "brew coffee") {
        line("Coffee is not in the dependency list, but every build step assumes it.", "muted");
      } else if (lower.startsWith("rm -rf")) {
        line("Blocked. This portfolio is append-only, like every good research log.", "muted");
      } else if (lower === "exit" || lower === "quit") {
        line("No exit. Scroll down instead — contact details are at the end.", "muted");
      } else if (lower === "date" || lower === "now") {
        line(new Date().toLocaleString("en-GB", { dateStyle: "medium", timeStyle: "short" }), "muted");
      } else if (head === "search") {
        search(rest.join(" "));
      } else {
        const exact = entries.find((entry) => entry.id === lower || entry.title.toLowerCase() === lower);
        if (exact) {
          result(exact);
        } else {
          search(command);
        }
      }

      scrollOutput();
    };

    line("samin.sh 1.0 — read-only portfolio shell", "mint");
    line("A keyword index over the facts on this site. Type `help` to begin.", "faint");

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const value = input.value;
      if (!value.trim()) return;
      history.push(value);
      historyIndex = history.length;
      input.value = "";
      run(value);
    });

    input.addEventListener("keydown", (event) => {
      if (event.key === "ArrowUp") {
        event.preventDefault();
        if (!history.length) return;
        historyIndex = Math.max(0, historyIndex - 1);
        input.value = history[historyIndex] ?? "";
        input.setSelectionRange(input.value.length, input.value.length);
      } else if (event.key === "ArrowDown") {
        event.preventDefault();
        if (!history.length) return;
        historyIndex = Math.min(history.length, historyIndex + 1);
        input.value = history[historyIndex] ?? "";
      } else if (event.key === "Escape") {
        input.blur();
      }
    });

    document.querySelectorAll<HTMLElement>("[data-cli-suggest]").forEach((button) => {
      button.addEventListener("click", () => {
        const command = button.dataset.cliSuggest ?? "";
        input.value = "";
        run(command);
        input.focus();
      });
    });

    shell?.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a, button")) return;
      input.focus();
    });

    const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    document.querySelectorAll<HTMLElement>("[data-open-terminal]").forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        event.preventDefault();
        document.getElementById("terminal")?.scrollIntoView({
          behavior: prefersReduced.matches ? "auto" : "smooth",
          block: "center",
        });
        window.setTimeout(() => input.focus({ preventScroll: true }), prefersReduced.matches ? 0 : 450);
      });
    });

    if (window.location.hash === "#terminal") {
      window.setTimeout(() => input.focus({ preventScroll: true }), 300);
    }

    // Navbar links to the terminal should land with the prompt ready.
    document
      .querySelectorAll<HTMLAnchorElement>('a[href="/#terminal"], a[href="#terminal"]')
      .forEach((link) => {
        link.addEventListener("click", () => {
          window.setTimeout(() => input.focus({ preventScroll: true }), 500);
        });
      });
  }
</script>
