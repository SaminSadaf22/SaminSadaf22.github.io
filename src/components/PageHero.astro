---
interface Props {
  eyebrow: string;
  title: string;
  accent?: string;
  description?: string;
}

const { eyebrow, title, accent, description } = Astro.props;
---

<section class="reveal relative border-b border-white/8 pb-12 pt-14 sm:pt-20">
  <p class="eyebrow">
    <span class="h-px w-7 bg-mint/60" aria-hidden="true"></span>
    {eyebrow}
  </p>
  <h1 class="mt-6 max-w-4xl font-display text-4xl font-semibold leading-[1.03] tracking-tight sm:text-5xl lg:text-6xl">
    {title}{accent && <span class="text-gradient"> {accent}</span>}
  </h1>
  {description && <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted">{description}</p>}
  <slot />
</section>
