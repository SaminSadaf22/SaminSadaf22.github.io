---
import MainLayout from "../layouts/MainLayout.astro";
import NeuralVisual from "../components/NeuralVisual.astro";

const focus = [
  {
    title: "Computer vision for agriculture",
    body: "Detecting plant disease from leaf imagery, where class imbalance and field conditions make clean benchmarks hard to trust.",
  },
  {
    title: "Transfer learning under constraint",
    body: "What holds up when compute and labelled data are both scarce — pretrained backbones, augmentation, and honest validation splits.",
  },
  {
    title: "Reproducible evaluation",
    body: "Documenting datasets, seeds and splits so a reported result can actually be re-run by someone else.",
  },
];
---

<MainLayout>
  <!-- Hero -->
  <section class="grid items-center gap-12 border-b border-line py-16 md:py-24 lg:grid-cols-[1.1fr_1fr]">
    <div>
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-faint">
        AI Researcher &amp; Builder · Dhaka, Bangladesh
      </p>
      <h1 class="mt-6 font-display text-4xl font-medium leading-[1.05] tracking-tight text-ink sm:text-5xl lg:text-6xl">
        Samin Sadaf
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-muted">
        I work on applied deep learning, most recently on detecting disease in
        corn leaves from images. My focus is on models that can be evaluated
        honestly — documented data, reproducible splits, and results reported as
        they are.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/research"
          class="inline-flex items-center gap-2 border border-mint px-5 py-2.5 font-mono text-[11px] uppercase tracking-[0.16em] text-mint transition-colors hover:bg-mint hover:text-canvas"
        >
          Research
        </a>
        <a
          href="/projects"
          class="inline-flex items-center gap-2 border border-line px-5 py-2.5 font-mono text-[11px] uppercase tracking-[0.16em] text-muted transition-colors hover:border-muted hover:text-ink"
        >
          Projects
        </a>
        <a
          href="/cv"
          class="inline-flex items-center gap-2 px-2 py-2.5 font-mono text-[11px] uppercase tracking-[0.16em] text-faint transition-colors hover:text-mint"
        >
          Curriculum Vitae
        </a>
      </div>
    </div>

    <NeuralVisual class="order-first lg:order-none" />
  </section>

  <!-- Featured research -->
  <section class="border-b border-line py-16">
    <div class="flex items-baseline justify-between gap-6">
      <h2 class="font-display text-xl font-medium tracking-tight">Current research</h2>
      <a href="/research" class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint hover:text-mint">
        All research
      </a>
    </div>

    <a
      href="/projects/corn-leaf-disease"
      class="group mt-6 block border border-line bg-card p-6 transition-colors hover:border-mint/50 sm:p-8"
    >
      <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-mint">Thesis · Deep learning</p>
      <h3 class="mt-3 font-display text-2xl font-medium tracking-tight text-ink">
        Corn Leaf Disease Detection Using Deep Learning
      </h3>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted">
        A comparative study of DenseNet121 and EfficientNet-B0 for classifying
        corn leaf disease from images, built as my undergraduate thesis at
        Daffodil International University.
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-2">
        {["DenseNet121", "EfficientNet-B0", "Transfer learning"].map((tag) => (
          <span class="border border-line px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.12em] text-faint">
            {tag}
          </span>
        ))}
        <span class="ml-auto font-mono text-[10px] uppercase tracking-[0.18em] text-muted group-hover:text-mint">
          Read the study →
        </span>
      </div>
    </a>
  </section>

  <!-- Focus -->
  <section class="border-b border-line py-16">
    <h2 class="font-display text-xl font-medium tracking-tight">Focus</h2>
    <div class="mt-8 grid gap-px border border-line bg-line sm:grid-cols-3">
      {focus.map((item, index) => (
        <div class="bg-canvas p-6">
          <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">
            {String(index + 1).padStart(2, "0")}
          </p>
          <h3 class="mt-4 font-display text-base font-medium tracking-tight text-ink">{item.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Footer CTA -->
  <section class="py-16">
    <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">Get in touch</p>
    <p class="mt-4 max-w-2xl font-display text-2xl font-medium leading-snug tracking-tight text-ink sm:text-3xl">
      Open to research collaboration and conversations about applied deep learning.
    </p>
    <a
      href="/contact"
      class="mt-6 inline-flex items-center gap-2 border border-line px-5 py-2.5 font-mono text-[11px] uppercase tracking-[0.16em] text-muted transition-colors hover:border-mint hover:text-mint"
    >
      Contact
    </a>
  </section>
</MainLayout>