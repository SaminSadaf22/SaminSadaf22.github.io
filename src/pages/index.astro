---
import MainLayout from "../layouts/MainLayout.astro";
import NeuralVisual from "../components/NeuralVisual.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ResumeSection from "../components/ResumeSection.astro";
import Terminal from "../components/Terminal.astro";
import { site } from "../data/site";
import { skillGroups, researchInterests } from "../data/profile";
import { projects } from "../data/projects";
import { publications } from "../data/publications";
import { ArrowRight, ArrowUpRight, Copy, MapPin } from "@lucide/astro";

const principles = [
  {
    title: "Report what the model actually did",
    body: "A number is only useful if someone can re-run it. Datasets, splits and seeds get documented alongside the result, not after it.",
  },
  {
    title: "Prefer the boring baseline",
    body: "New architectures are easy to justify after the fact. I try to establish what a simpler model achieves first, then argue for complexity with evidence.",
  },
  {
    title: "Build the thing, not just the notebook",
    body: "A trained model that nobody can run is a claim, not a system. I care about the path from experiment to something usable.",
  },
];

const marqueeItems = [
  ...skillGroups.flatMap((group) => group.items),
  "DenseNet121",
  "EfficientNet-B0",
  "Deep learning",
];

const featured = projects[0];
const secondary = projects[1];
---

<MainLayout>
  <!-- Hero -->
  <section
    id="top"
    class="relative grid scroll-mt-28 items-center gap-14 pb-16 pt-14 sm:pt-20 lg:grid-cols-[1.06fr_0.94fr] lg:gap-12 lg:pt-24"
  >
    <div class="reveal">
      <div
        class="inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/[0.03] px-3.5 py-1.5 backdrop-blur"
      >
        <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-mint opacity-60"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-mint"></span>
        </span>
        <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted">
          Open to research collaborations
        </span>
      </div>

      <h1 class="mt-7 font-display text-5xl font-semibold leading-[0.95] tracking-tight sm:text-7xl lg:text-[5.1rem]">
        Samin <span class="text-gradient">Sadaf</span>
      </h1>

      <p class="mt-6 font-serif text-2xl italic leading-snug text-muted sm:text-[1.75rem]">
        Applied deep learning,<br class="hidden sm:block" />
        <span class="text-mint">honestly evaluated.</span>
      </p>

      <p class="mt-6 max-w-xl text-base leading-relaxed text-muted">
        I work on applied deep learning, most recently on detecting disease in
        corn leaves from images. My focus is on models that can be evaluated
        honestly — documented data, reproducible splits, and results reported as
        they are.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a href="#research" class="btn btn-primary">
          Explore my research
          <ArrowRight size={14} strokeWidth={1.75} aria-hidden="true" />
        </a>
        <a href="#projects" class="btn btn-ghost">
          View projects
          <ArrowUpRight size={14} strokeWidth={1.75} aria-hidden="true" />
        </a>
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2">
        <a
          href="#terminal"
          data-open-terminal
          class="group inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.16em] text-faint transition-colors hover:text-mint"
        >
          <span
            class="grid h-6 w-6 place-items-center rounded-md border border-line font-mono text-[10px] text-mint transition-colors group-hover:border-mint/40"
          >
            &gt;_
          </span>
          Ask my terminal
          <kbd class="rounded border border-line px-1.5 py-0.5 font-mono text-[9px] tracking-[0.1em] text-faint">
            Ctrl K
          </kbd>
        </a>
      </div>

      <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[10px] uppercase tracking-[0.16em] text-faint">
        <span class="inline-flex items-center gap-1.5">
          <MapPin size={12} strokeWidth={1.75} aria-hidden="true" />
          {site.location}
        </span>
        <span class="hidden h-3 w-px bg-line sm:block" aria-hidden="true"></span>
        <span>{site.role}</span>
      </div>
    </div>

    <!-- Thesis panel -->
    <div class="reveal relative" style="transition-delay: 120ms">
      <div
        class="absolute -inset-5 rounded-[2.5rem] bg-linear-to-br from-mint/20 via-transparent to-violet/20 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div
        class="relative overflow-hidden rounded-3xl border border-white/10 bg-[#080d17]/85 p-1.5 shadow-[0_40px_90px_-50px_rgba(0,0,0,1)] backdrop-blur"
      >
        <div class="flex items-stretch border-b border-white/5">
          <div class="flex min-w-0 items-center gap-2 px-3 py-2">
            <span
              class="grid h-4 w-4 shrink-0 place-items-center rounded-sm border border-mint/25 bg-mint/5 font-mono text-[8px] leading-none text-mint"
              aria-hidden="true"
            >
              &gt;_
            </span>
            <span class="truncate font-mono text-[10px] tracking-[0.14em] text-faint">
              thesis.2026 — review
            </span>
          </div>
          <div class="ml-auto flex shrink-0 items-stretch" aria-hidden="true">
            <span class="grid w-6 place-items-center border-l border-white/5 font-mono text-[9px] leading-none text-faint/50">─</span>
            <span class="grid w-6 place-items-center border-l border-white/5 font-mono text-[9px] leading-none text-faint/50">□</span>
            <span class="grid w-7 place-items-center border-l border-white/5 font-mono text-[10px] leading-none text-faint/50">✕</span>
          </div>
        </div>

        <div class="rounded-2xl border border-white/5 bg-[#060a12] p-5 sm:p-6">
          <NeuralVisual />

          <div class="mt-5 flex items-center justify-between gap-3 border-t border-white/5 pt-4">
            <div>
              <p class="font-mono text-[9px] uppercase tracking-[0.18em] text-faint">Thesis</p>
              <p class="mt-1.5 text-sm font-medium text-ink">Corn leaf disease detection</p>
            </div>
            <a
              href="/projects/corn-leaf-disease"
              aria-label="Read the corn leaf disease thesis"
              class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-white/10 text-muted transition-colors hover:border-mint/40 hover:text-mint"
            >
              <ArrowUpRight size={15} strokeWidth={1.75} aria-hidden="true" />
            </a>
          </div>

          <dl class="mt-4 grid grid-cols-2 gap-2">
            <div class="rounded-xl border border-white/5 bg-white/[0.02] px-3 py-2.5">
              <dt class="font-mono text-[9px] uppercase tracking-[0.14em] text-faint">Model A</dt>
              <dd class="mt-1 font-mono text-[11px] text-mint">DenseNet121</dd>
            </div>
            <div class="rounded-xl border border-white/5 bg-white/[0.02] px-3 py-2.5">
              <dt class="font-mono text-[9px] uppercase tracking-[0.14em] text-faint">Model B</dt>
              <dd class="mt-1 font-mono text-[11px] text-azure">EfficientNet-B0</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- Skill ribbon -->
  <div class="marquee -mx-5 border-y border-white/10 py-4 sm:-mx-8">
    <div class="marquee-track">
      {[...marqueeItems, ...marqueeItems].map((item, index) => (
        <span
          class="flex items-center gap-3 px-5 font-mono text-[11px] uppercase tracking-[0.18em] text-faint"
          aria-hidden={index >= marqueeItems.length ? "true" : undefined}
        >
          <span class="h-1 w-1 rounded-full bg-mint/60" aria-hidden="true"></span>
          {item}
        </span>
      ))}
    </div>
  </div>

  <!-- About -->
  <section id="about" class="reveal scroll-mt-28 border-t border-white/10 py-16 sm:py-20">
    <SectionHeading
      eyebrow="About"
      title="Research first, engineering close behind"
      description="The short version of why the work looks like this — and what I would rather not pretend."
    />

    <div class="mt-9 grid gap-8 lg:grid-cols-[1.4fr_0.6fr] lg:gap-12">
      <div class="space-y-4 text-[14px] leading-relaxed text-muted sm:text-[15px]">
        <p>
          I'm an AI researcher and builder based in {site.location}. My work sits
          at the intersection of applied deep learning and the practical question
          of whether a model does anything useful outside a notebook.
        </p>
        <p>
          My undergraduate thesis compared DenseNet121 and EfficientNet-B0 for
          detecting disease in corn leaves from images. It was my first sustained
          piece of research, and the most valuable part wasn't the modelling — it
          was learning how much of a result depends on decisions made before
          training starts: how the data is split, what is held out, and what the
          number on the screen actually describes.
        </p>
        <p>
          I studied software engineering at Daffodil International University,
          graduating in June 2026. That background shapes how I approach research:
          I'd rather ship something reproducible than something impressive — and I
          can build the surrounding system, not just the experiment.
        </p>
        <p>
          I'm at the beginning of a research career and I'd rather say that plainly
          than inflate it. What I have is work I can explain end to end, and a
          clear direction: computer vision applied to problems where the data is
          messy and the stakes are real.
        </p>
      </div>

      <aside class="card-surface h-fit rounded-2xl p-6">
        <dl class="space-y-5">
          <div>
            <dt class="font-mono text-[9px] uppercase tracking-[0.18em] text-faint">Based in</dt>
            <dd class="mt-1.5 text-[13px] text-ink">{site.location}</dd>
          </div>
          <div>
            <dt class="font-mono text-[9px] uppercase tracking-[0.18em] text-faint">Focus</dt>
            <dd class="mt-1.5 text-[13px] text-ink">Applied deep learning, computer vision</dd>
          </div>
          <div>
            <dt class="font-mono text-[9px] uppercase tracking-[0.18em] text-faint">Education</dt>
            <dd class="mt-1.5 text-[13px] text-ink">BSc Software Engineering, DIU · 2026</dd>
          </div>
          <div>
            <dt class="font-mono text-[9px] uppercase tracking-[0.18em] text-faint">Status</dt>
            <dd class="mt-1.5 text-[13px] text-mint">Open to research collaboration</dd>
          </div>
        </dl>
        <div class="mt-6 border-t border-white/10 pt-5">
          <p class="font-mono text-[9px] uppercase tracking-[0.18em] text-faint">Elsewhere</p>
          <ul class="mt-3 space-y-1.5">
            {site.socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-[12px] text-muted transition-colors hover:text-mint"
                >
                  {social.label}
                  <ArrowUpRight size={11} strokeWidth={1.75} aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {principles.map((principle, index) => (
        <div class="card-surface rounded-2xl p-5">
          <p class="font-mono text-[9px] uppercase tracking-[0.18em] text-faint">
            {String(index + 1).padStart(2, "0")}
          </p>
          <h3 class="mt-3 font-display text-[15px] font-medium leading-snug tracking-tight text-ink">
            {principle.title}
          </h3>
          <p class="mt-2.5 text-[12px] leading-relaxed text-muted">{principle.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Research -->
  <section id="research" class="reveal scroll-mt-28 border-t border-white/10 py-16 sm:py-20">
    <SectionHeading
      eyebrow="Research"
      title="One question, documented end to end"
      description="The thesis is the whole research record so far. It is shown in full rather than trimmed to a headline number."
      href="/projects/corn-leaf-disease"
      linkLabel="Read the study"
    />

    <div class="mt-9 grid gap-4 lg:grid-cols-5">
      {featured && (
        <article class="card-surface relative overflow-hidden rounded-2xl p-7 sm:p-8 lg:col-span-3">
          <div
            class="pointer-events-none absolute -right-20 -top-24 h-64 w-64 rounded-full bg-mint/10 blur-3xl"
            aria-hidden="true"
          >
          </div>
          <div class="relative">
            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-mint">
              {featured.period}
            </p>
            <h3 class="mt-4 font-display text-2xl font-semibold leading-tight tracking-tight text-ink sm:text-3xl">
              {featured.title}
            </h3>
            <p class="mt-4 max-w-xl text-sm leading-relaxed text-muted">{featured.summary}</p>

            <dl class="mt-6 grid gap-2 sm:grid-cols-2">
              <div class="rounded-xl border border-white/5 bg-white/[0.02] px-4 py-3">
                <dt class="font-mono text-[9px] uppercase tracking-[0.14em] text-faint">Model A</dt>
                <dd class="mt-1 font-mono text-[11px] text-mint">DenseNet121</dd>
              </div>
              <div class="rounded-xl border border-white/5 bg-white/[0.02] px-4 py-3">
                <dt class="font-mono text-[9px] uppercase tracking-[0.14em] text-faint">Model B</dt>
                <dd class="mt-1 font-mono text-[11px] text-azure">EfficientNet-B0</dd>
              </div>
            </dl>

            <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
              <div class="flex flex-wrap gap-1.5">
                {featured.tags.map((tag) => (
                  <span class="rounded-full border border-line px-2.5 py-0.5 font-mono text-[9px] text-faint">
                    {tag}
                  </span>
                ))}
              </div>
              <a
                href={featured.href}
                class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.14em] text-muted transition-colors hover:text-mint"
              >
                Case study
                <ArrowUpRight size={12} strokeWidth={1.75} aria-hidden="true" />
              </a>
            </div>
          </div>
        </article>
      )}

      <div class="grid gap-4 lg:col-span-2">
        {researchInterests.map((interest, index) => (
          <div class="card-surface rounded-2xl p-5">
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-display text-[15px] font-medium leading-snug tracking-tight text-ink">
                {interest.title}
              </h3>
              <span class="font-mono text-[9px] text-faint">
                {String(index + 1).padStart(2, "0")}
              </span>
            </div>
            <p class="mt-2 text-[12px] leading-relaxed text-muted">{interest.detail}</p>
          </div>
        ))}

        <div class="rounded-2xl border border-dashed border-line p-5">
          <div class="flex items-center justify-between gap-3">
            <p class="font-mono text-[9px] uppercase tracking-[0.18em] text-faint">Publications</p>
            <span class="rounded-full border border-line px-2 py-0.5 font-mono text-[8px] uppercase tracking-[0.14em] text-faint">
              {publications.length === 0 ? "None yet" : `${publications.length} listed`}
            </span>
          </div>
          <p class="mt-2 text-[12px] leading-relaxed text-muted">
            {publications.length === 0
              ? "No peer-reviewed papers to list. The section stays empty rather than aspirational."
              : "Peer-reviewed work as it appears."}
          </p>
          <a
            href="/publications"
            class="mt-3 inline-flex items-center gap-1.5 font-mono text-[9px] uppercase tracking-[0.14em] text-muted transition-colors hover:text-mint"
          >
            Publications
            <ArrowUpRight size={10} strokeWidth={1.75} aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected work -->
  <section id="projects" class="reveal scroll-mt-28 border-t border-white/10 py-16 sm:py-20">
    <SectionHeading
      eyebrow="Selected work"
      title="Projects, not screenshots"
      description="One research project documented end to end, plus the engineering work that came before it."
      href="/projects"
      linkLabel="All projects"
    />

    <div class="mt-9 grid gap-4 lg:grid-cols-5">
      {featured && (
        <a
          href={featured.href ?? "/projects"}
          class="card-surface group relative flex flex-col justify-between overflow-hidden rounded-2xl p-7 sm:p-9 lg:col-span-3"
        >
          <div
            class="pointer-events-none absolute -right-20 -top-24 h-64 w-64 rounded-full bg-mint/10 blur-3xl transition-opacity duration-500 group-hover:bg-mint/20"
            aria-hidden="true"
          >
          </div>

          <div class="relative">
            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-mint">
              {featured.category} · 2026
            </p>
            <h3 class="mt-4 max-w-xl font-display text-2xl font-semibold leading-tight tracking-tight text-ink sm:text-3xl">
              {featured.title}
            </h3>
            <p class="mt-4 max-w-xl text-sm leading-relaxed text-muted">{featured.summary}</p>
          </div>

          <div class="relative mt-9 flex flex-wrap items-end justify-between gap-4">
            <div class="flex flex-wrap gap-2">
              {featured.tags.map((tag) => (
                <span class="rounded-full border border-line bg-white/[0.02] px-3 py-1 font-mono text-[10px] tracking-[0.08em] text-faint">
                  {tag}
                </span>
              ))}
            </div>
            <span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.16em] text-muted transition-colors group-hover:text-mint">
              Read the study
              <ArrowUpRight size={13} strokeWidth={1.75} aria-hidden="true" />
            </span>
          </div>
        </a>
      )}

      <div class="grid gap-4 lg:col-span-2">
        {secondary && (
          <div class="card-surface flex flex-col rounded-2xl p-6">
            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">
              {secondary.category}
            </p>
            <h3 class="mt-3 font-display text-lg font-medium leading-snug tracking-tight text-ink">
              {secondary.title}
            </h3>
            <p class="mt-3 flex-1 text-[13px] leading-relaxed text-muted">{secondary.summary}</p>
            <div class="mt-5 flex flex-wrap gap-2">
              {secondary.tags.map((tag) => (
                <span class="rounded-full border border-line px-2.5 py-0.5 font-mono text-[10px] text-faint">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        )}

        <a
          href="/projects"
          class="group flex items-center justify-between gap-4 rounded-2xl border border-dashed border-line px-6 py-5 transition-colors hover:border-mint/40"
        >
          <span>
            <span class="block font-display text-base font-medium tracking-tight text-ink">
              More work
            </span>
            <span class="mt-1 block font-mono text-[10px] uppercase tracking-[0.14em] text-faint">
              Research and engineering
            </span>
          </span>
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-line text-muted transition-colors group-hover:border-mint/40 group-hover:text-mint">
            <ArrowRight size={15} strokeWidth={1.75} aria-hidden="true" />
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Toolkit -->
  <section id="toolkit" class="reveal scroll-mt-28 border-t border-white/10 py-16 sm:py-20">
    <SectionHeading
      eyebrow="Toolkit"
      title="Stack and methods"
      description="What I reach for, listed plainly — no proficiency scores, no invented tools."
      href="/profile"
      linkLabel="Technical profile"
    />

    <div class="mt-9 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {skillGroups.map((group, index) => (
        <div class="card-surface rounded-2xl p-6">
          <div class="flex items-baseline justify-between gap-3">
            <h3 class="font-mono text-[10px] uppercase tracking-[0.16em] text-mint">{group.title}</h3>
            <span class="font-mono text-[10px] text-faint">{String(index + 1).padStart(2, "0")}</span>
          </div>
          <ul class="mt-5 flex flex-wrap gap-1.5">
            {group.items.map((item) => (
              <li class="rounded-full border border-line bg-white/[0.02] px-2.5 py-1 text-[11px] text-muted">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <ResumeSection />

  <Terminal />

  <!-- Contact CTA -->
  <section id="contact" class="reveal scroll-mt-28 py-16 sm:py-20">
    <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-linear-to-b from-white/[0.06] to-white/[0.01] p-8 sm:p-12">
      <div
        class="pointer-events-none absolute -right-24 -top-32 h-80 w-80 rounded-full bg-mint/15 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-32 -left-20 h-72 w-72 rounded-full bg-violet/10 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <div class="relative max-w-2xl">
        <p class="eyebrow">
          <span class="h-px w-7 bg-mint/60" aria-hidden="true"></span>
          Contact
        </p>
        <h2 class="mt-5 font-display text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">
          Let's work on something
          <span class="text-gradient">worth evaluating.</span>
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-muted sm:text-base">
          Open to research collaboration and conversations about applied deep
          learning. Email is the most direct route — I reply to anything specific
          about the work.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={`mailto:${site.email}`} class="btn btn-primary">
            Email me
            <ArrowUpRight size={14} strokeWidth={1.75} aria-hidden="true" />
          </a>
          <button type="button" id="copy-email" data-email={site.email} class="btn btn-ghost">
            <Copy size={13} strokeWidth={1.75} aria-hidden="true" />
            <span data-copy-label>Copy email</span>
          </button>
        </div>

        <p class="mt-6 break-all font-mono text-[10px] uppercase tracking-[0.16em] text-faint">
          {site.email} · {site.phone}
        </p>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  const copyButton = document.getElementById("copy-email");
  copyButton?.addEventListener("click", async () => {
    const email = copyButton.dataset.email;
    if (!email) return;

    try {
      await navigator.clipboard.writeText(email);
    } catch {
      return;
    }

    const label = copyButton.querySelector("[data-copy-label]");
    if (!label) return;

    const original = label.textContent ?? "Copy email";
    label.textContent = "Copied";
    window.setTimeout(() => {
      label.textContent = original;
    }, 1800);
  });
</script>
