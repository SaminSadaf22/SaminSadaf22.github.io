---
import MainLayout from "../../layouts/MainLayout.astro";
import {
  CHANNELS,
  CHANNEL_LABELS,
  DEFAULT_INPUT,
  createState,
  step,
  type Channel,
} from "../../lib/cognitive-loop";

const initial = step(createState(), DEFAULT_INPUT);

const pct = (value: number) => `${Math.round(value * 100)}%`;
const valencePct = (value: number) => `${Math.round(((value + 1) / 2) * 100)}%`;
const signed = (value: number) => `${value >= 0 ? "+" : ""}${value.toFixed(2)}`;

const loop = [
  {
    title: "Predict",
    body: "Each channel keeps an expectation. The difference between expectation and observation becomes prediction error.",
  },
  {
    title: "Compete",
    body: "Salience blends prediction error, signal strength and novelty. Only the two strongest channels win access.",
  },
  {
    title: "Broadcast",
    body: "The winning channels enter a tiny global workspace. Everything else stays peripheral for this tick.",
  },
  {
    title: "Integrate",
    body: "Valence and arousal update from reward, threat, error and social presence, then feed a decaying memory trace.",
  },
  {
    title: "Act",
    body: "The integrated state selects one of four actions: approach, withdraw, explore or hold.",
  },
  {
    title: "Report",
    body: "A deterministic self-report maps the workspace, error, memory, feeling and action into one first-person sentence.",
  },
];

const predictions = [
  {
    title: "Workspace ablation",
    body: "Removing the two-channel bottleneck should make action selection less stable under conflicting inputs, not more stable.",
  },
  {
    title: "Affect ablation",
    body: "Removing valence and arousal should reduce adaptive prioritisation of threat and reward.",
  },
  {
    title: "Report grounding",
    body: "The self-report should track the internal variables — workspace, error, affect — rather than simply echo the input labels.",
  },
  {
    title: "Memory ablation",
    body: "Removing the memory trace should make the reported state jump around more between similar inputs.",
  },
];
---

<MainLayout
  title="Cognitive AI: a global-workspace hypothesis"
  description="A small, inspectable cognitive loop that models prediction, attention, affect, memory and self-report — without claiming consciousness."
>
  <section class="border-b border-line py-14">
    <a
      href="/projects"
      class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint transition-colors hover:text-mint"
    >
      ← Projects
    </a>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-mint">
        AI research · hypothesis
      </p>
      <span class="border border-amber-300/25 bg-amber-300/5 px-2 py-1 font-mono text-[9px] uppercase tracking-[0.14em] text-amber-200/80">
        Prototype, not sentience
      </span>
    </div>
    <h1 class="mt-5 max-w-4xl font-display text-4xl font-medium leading-[1.1] tracking-tight sm:text-5xl">
      A small loop that says “I feel.”
    </h1>
    <p class="mt-6 max-w-2xl text-base leading-relaxed text-muted">
      This is an independent hypothesis and a runnable prototype, not a claim
      that a machine is conscious. The question is narrower: can a transparent
      recurrent loop produce behaviour that looks like human-like cognition —
      limited attention, prediction, affect, memory and a coherent self-report?
    </p>
  </section>

  <section class="border-b border-line py-14">
    <h2 class="font-display text-xl font-medium tracking-tight">The hypothesis</h2>
    <p class="mt-5 max-w-3xl text-base leading-relaxed text-muted">
      Consciousness-like behaviour in an artificial system can be approximated
      by a recurrent loop that predicts incoming signals, broadcasts the most
      salient prediction errors through a small global workspace, integrates
      them with decaying memory and affect, selects an action, and emits a
      first-person report of its current state. If the same loop stays coherent
      across varied inputs, it is a useful <em class="text-ink">functional</em>
      model of human-like cognition — not evidence of phenomenal experience.
    </p>

    <div class="mt-8 grid gap-px border border-line bg-line md:grid-cols-3">
      <div class="bg-canvas p-6">
        <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">01 · Prediction</p>
        <h3 class="mt-4 font-display text-base font-medium tracking-tight text-ink">Expectation first</h3>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          The loop is never a passive receiver. It arrives with a prediction and
          notices what violates it.
        </p>
      </div>
      <div class="bg-canvas p-6">
        <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">02 · Integration</p>
        <h3 class="mt-4 font-display text-base font-medium tracking-tight text-ink">A narrow workspace</h3>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Only two channels are broadcast at once. The bottleneck is the point:
          it forces competition and makes attention inspectable.
        </p>
      </div>
      <div class="bg-canvas p-6">
        <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">03 · Self-report</p>
        <h3 class="mt-4 font-display text-base font-medium tracking-tight text-ink">A generated “I”</h3>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          The first-person sentence is a template over internal variables. It
          tests whether the architecture can describe itself coherently.
        </p>
      </div>
    </div>
  </section>

  <section class="border-b border-line py-14">
    <h2 class="font-display text-xl font-medium tracking-tight">The loop, one tick at a time</h2>
    <div class="mt-8 grid gap-px border border-line bg-line md:grid-cols-2">
      {loop.map((item, index) => (
        <div class="bg-canvas p-6">
          <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">
            {String(index + 1).padStart(2, "0")}
          </p>
          <h3 class="mt-3 font-display text-base font-medium tracking-tight text-ink">{item.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="demo" class="border-b border-line py-14">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-mint">Live prototype</p>
        <h2 class="mt-3 font-display text-2xl font-medium tracking-tight">Step the loop</h2>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-muted">
          Move the five input sliders, then step the loop. The report is
          generated from the internal state, not written per scenario.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <button type="button" data-cog-step class="btn btn-primary">Step</button>
        <button type="button" data-cog-reset class="btn btn-ghost">Reset</button>
      </div>
    </div>

    <div class="mt-8 grid gap-px border border-line bg-line lg:grid-cols-[0.9fr_1.1fr]">
      <div class="bg-canvas p-6">
        <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">Input channels</p>
        <div class="mt-6 space-y-5">
          {CHANNELS.map((channel) => (
            <div>
              <div class="flex items-center justify-between gap-3">
                <label
                  for={`cog-${channel}`}
                  class="font-mono text-[10px] uppercase tracking-[0.14em] text-muted"
                >
                  {CHANNEL_LABELS[channel]}
                </label>
                <output
                  for={`cog-${channel}`}
                  data-cog-value={channel}
                  class="font-mono text-[10px] text-faint"
                >
                  {Math.round(DEFAULT_INPUT[channel] * 100)}
                </output>
              </div>
              <input
                id={`cog-${channel}`}
                data-cog-input={channel}
                type="range"
                min="0"
                max="100"
                step="1"
                value={Math.round(DEFAULT_INPUT[channel] * 100)}
                class="mt-2 w-full accent-mint"
              />
            </div>
          ))}
        </div>
        <p class="mt-6 text-xs leading-relaxed text-faint">
          Sliders are the whole sensory world. The loop has no learning and no
          hidden language model.
        </p>
      </div>

      <div class="bg-canvas p-6">
        <div class="flex items-center justify-between gap-3">
          <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">Internal state</p>
          <span data-cog-tick class="font-mono text-[10px] text-faint">tick {initial.tick}</span>
        </div>

        <div class="mt-5 border border-line bg-[#050910] p-5">
          <p class="font-mono text-[9px] uppercase tracking-[0.18em] text-faint">Self-report</p>
          <p data-cog-narrative class="mt-3 font-serif text-xl leading-snug text-ink">
            {initial.narrative}
          </p>
          <div class="mt-5 flex flex-wrap items-center gap-2">
            <span
              data-cog-feeling
              class="border border-mint/25 bg-mint/5 px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.12em] text-mint"
            >
              {initial.feeling}
            </span>
            <span
              data-cog-action
              class="border border-white/10 bg-white/[0.03] px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.12em] text-muted"
            >
              {initial.action}
            </span>
            <span class="font-mono text-[10px] text-faint">
              workspace: <span data-cog-workspace>{initial.workspace.map((channel) => CHANNEL_LABELS[channel]).join(" · ")}</span>
            </span>
          </div>
        </div>

        <div class="mt-5 grid gap-4 sm:grid-cols-3">
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="font-mono text-[9px] uppercase tracking-[0.14em] text-faint">Valence</span>
              <span data-cog-valence class="font-mono text-[10px] text-muted">{signed(initial.valence)}</span>
            </div>
            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-line">
              <div
                data-cog-valence-fill
                class="h-full rounded-full bg-mint transition-[width] duration-300"
                style={`width: ${valencePct(initial.valence)}%`}
              >
              </div>
            </div>
          </div>
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="font-mono text-[9px] uppercase tracking-[0.14em] text-faint">Arousal</span>
              <span data-cog-arousal class="font-mono text-[10px] text-muted">{initial.arousal.toFixed(2)}</span>
            </div>
            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-line">
              <div
                data-cog-arousal-fill
                class="h-full rounded-full bg-violet transition-[width] duration-300"
                style={`width: ${pct(initial.arousal)}`}
              >
              </div>
            </div>
          </div>
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="font-mono text-[9px] uppercase tracking-[0.14em] text-faint">Memory</span>
              <span data-cog-memory class="font-mono text-[10px] text-muted">{initial.memory.toFixed(2)}</span>
            </div>
            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-line">
              <div
                data-cog-memory-fill
                class="h-full rounded-full bg-azure transition-[width] duration-300"
                style={`width: ${pct(initial.memory)}%`}
              >
              </div>
            </div>
          </div>
        </div>

        <div class="mt-6">
          <p class="font-mono text-[9px] uppercase tracking-[0.18em] text-faint">Prediction error</p>
          <ul class="mt-4 space-y-2.5">
            {CHANNELS.map((channel: Channel) => (
              <li class="grid grid-cols-[92px_1fr_38px] items-center gap-3">
                <span class="font-mono text-[9px] uppercase tracking-[0.1em] text-faint">
                  {CHANNEL_LABELS[channel]}
                </span>
                <span class="h-1.5 overflow-hidden rounded-full bg-line">
                  <span
                    data-cog-error={channel}
                    class="block h-full rounded-full bg-azure transition-[width] duration-300"
                    style={`width: ${pct(initial.error[channel])}`}
                  >
                  </span>
                </span>
                <span data-cog-error-value={channel} class="text-right font-mono text-[10px] text-faint">
                  {initial.error[channel].toFixed(2)}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <p class="mt-4 max-w-3xl text-xs leading-relaxed text-faint">
      The “I” in the report is a template over valence, arousal, workspace and
      prediction error. It is not a subject and it is not conscious.
    </p>
  </section>

  <section class="border-b border-line py-14">
    <h2 class="font-display text-xl font-medium tracking-tight">What would falsify it</h2>
    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted">
      A hypothesis that cannot fail is not useful. These are the comparisons the
      prototype is designed to make possible.
    </p>
    <div class="mt-8 grid gap-px border border-line bg-line sm:grid-cols-2">
      {predictions.map((item) => (
        <div class="bg-canvas p-6">
          <h3 class="font-display text-base font-medium tracking-tight text-ink">{item.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="border-b border-line py-14">
    <h2 class="font-display text-xl font-medium tracking-tight">Limits and ethics</h2>
    <ul class="mt-8 divide-y divide-line border-y border-line">
      <li class="flex gap-4 py-5">
        <span class="mt-2 h-1 w-1 shrink-0 bg-mint" aria-hidden="true" />
        <p class="max-w-2xl text-sm leading-relaxed text-muted">
          The loop is deterministic and hand-designed. It does not learn, and
          changing one constant changes the behaviour.
        </p>
      </li>
      <li class="flex gap-4 py-5">
        <span class="mt-2 h-1 w-1 shrink-0 bg-mint" aria-hidden="true" />
        <p class="max-w-2xl text-sm leading-relaxed text-muted">
          “Feeling” is a label derived from two scalar variables. It is not a
          subjective state, and the self-report must never be presented as one.
        </p>
      </li>
      <li class="flex gap-4 py-5">
        <span class="mt-2 h-1 w-1 shrink-0 bg-mint" aria-hidden="true" />
        <p class="max-w-2xl text-sm leading-relaxed text-muted">
          The workspace is a top-two sort, not a biological global neuronal
          workspace. It borrows vocabulary from global workspace theory,
          predictive processing and constructed emotion; it does not implement
          any of them.
        </p>
      </li>
      <li class="flex gap-4 py-5">
        <span class="mt-2 h-1 w-1 shrink-0 bg-mint" aria-hidden="true" />
        <p class="max-w-2xl text-sm leading-relaxed text-muted">
          There is no body, no continuous sensorimotor stream and no social
          learning. This is a conceptual instrument, not a benchmark or a
          publication.
        </p>
      </li>
    </ul>
  </section>

  <section class="flex flex-wrap items-center gap-3 py-14">
    <a
      href="https://github.com/SaminSadaf22/cognitive-ai"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center border border-line px-5 py-2.5 font-mono text-[11px] uppercase tracking-[0.16em] text-muted transition-colors hover:border-mint hover:text-mint"
    >
      README and demo on GitHub ↗
    </a>
    <a
      href="/projects"
      class="inline-flex items-center px-2 py-2.5 font-mono text-[11px] uppercase tracking-[0.16em] text-faint transition-colors hover:text-mint"
    >
      All projects →
    </a>
  </section>
</MainLayout>

<script>
  import {
    CHANNELS,
    CHANNEL_LABELS,
    DEFAULT_INPUT,
    createState,
    step,
    type CognitiveInput,
  } from "../../lib/cognitive-loop";

  const sliders = Array.from(
    document.querySelectorAll<HTMLInputElement>("[data-cog-input]"),
  );

  const input: CognitiveInput = { ...DEFAULT_INPUT };
  let state = step(createState(), input);

  const setText = (selector: string, value: string) => {
    const element = document.querySelector<HTMLElement>(selector);
    if (element) element.textContent = value;
  };

  const setWidth = (selector: string, value: number) => {
    const element = document.querySelector<HTMLElement>(selector);
    if (element) element.style.width = `${Math.round(value * 100)}%`;
  };

  const render = () => {
    setText("[data-cog-tick]", `tick ${state.tick}`);
    setText("[data-cog-narrative]", state.narrative);
    setText("[data-cog-feeling]", state.feeling);
    setText("[data-cog-action]", state.action);
    setText(
      "[data-cog-workspace]",
      state.workspace.map((channel) => CHANNEL_LABELS[channel]).join(" · "),
    );

    setText("[data-cog-valence]", `${state.valence >= 0 ? "+" : ""}${state.valence.toFixed(2)}`);
    setText("[data-cog-arousal]", state.arousal.toFixed(2));
    setText("[data-cog-memory]", state.memory.toFixed(2));

    setWidth("[data-cog-valence-fill]", (state.valence + 1) / 2);
    setWidth("[data-cog-arousal-fill]", state.arousal);
    setWidth("[data-cog-memory-fill]", state.memory);

    for (const channel of CHANNELS) {
      setText(`[data-cog-value="${channel}"]`, String(Math.round(input[channel] * 100)));
      setText(`[data-cog-error-value="${channel}"]`, state.error[channel].toFixed(2));
      setWidth(`[data-cog-error="${channel}"]`, state.error[channel]);
    }
  };

  const readInput = () => {
    for (const slider of sliders) {
      const channel = slider.dataset.cogInput;
      if (channel && channel in input) {
        input[channel as keyof CognitiveInput] = Number(slider.value) / 100;
      }
    }
  };

  for (const slider of sliders) {
    slider.addEventListener("input", () => {
      const channel = slider.dataset.cogInput;
      if (channel) setText(`[data-cog-value="${channel}"]`, slider.value);
    });

    slider.addEventListener("change", () => {
      readInput();
      state = step(state, input);
      render();
    });
  }

  document.querySelector("[data-cog-step]")?.addEventListener("click", () => {
    readInput();
    state = step(state, input);
    render();
  });

  document.querySelector("[data-cog-reset]")?.addEventListener("click", () => {
    Object.assign(input, DEFAULT_INPUT);
    for (const slider of sliders) {
      const channel = slider.dataset.cogInput as keyof CognitiveInput | undefined;
      if (channel) slider.value = String(Math.round(input[channel] * 100));
    }
    state = step(createState(), input);
    render();
  });
</script>
