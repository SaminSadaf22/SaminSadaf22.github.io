---
import MainLayout from "../../layouts/MainLayout.astro";
import { thesis } from "../../data/thesis";

const meta = [
  { term: "Institution", detail: thesis.institution },
  { term: "Period", detail: thesis.period },
  { term: "Models", detail: "DenseNet121 · EfficientNet-B0" },
];
---

<MainLayout title={thesis.title} description={thesis.summary.slice(0, 155)}>
  <section class="border-b border-line py-14">
    <a
      href="/projects"
      class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint transition-colors hover:text-mint"
    >
      ← Projects
    </a>
    <p class="mt-8 font-mono text-[10px] uppercase tracking-[0.22em] text-mint">
      {thesis.kind} · Deep learning
    </p>
    <h1 class="mt-5 max-w-3xl font-display text-4xl font-medium leading-[1.1] tracking-tight sm:text-5xl">
      {thesis.title}
    </h1>

    <dl class="mt-10 grid gap-px border border-line bg-line sm:grid-cols-3">
      {meta.map((item) => (
        <div class="bg-canvas p-5">
          <dt class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">{item.term}</dt>
          <dd class="mt-2 text-sm text-ink">{item.detail}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="border-b border-line py-14">
    <p class="max-w-2xl text-base leading-relaxed text-muted">{thesis.summary}</p>
  </section>

  <section class="border-b border-line py-14">
    <h2 class="font-display text-xl font-medium tracking-tight">What the comparison isolates</h2>
    <div class="mt-8 grid gap-px border border-line bg-line md:grid-cols-3">
      {thesis.variables.map((variable, index) => (
        <div class="bg-canvas p-6">
          <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">
            {String(index + 1).padStart(2, "0")}
          </p>
          <h3 class="mt-4 font-display text-base font-medium tracking-tight text-ink">
            {variable.title}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-muted">{variable.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="border-b border-line py-14">
    <h2 class="font-display text-xl font-medium tracking-tight">Results</h2>

    {thesis.results.length > 0 ? (
      <div class="mt-6 overflow-x-auto border border-line">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="bg-card text-left">
              <th class="px-4 py-3 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-faint">
                Model
              </th>
              <th class="px-4 py-3 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-faint">
                Test accuracy
              </th>
              <th class="px-4 py-3 font-mono text-[10px] font-medium uppercase tracking-[0.16em] text-faint">
                Macro F1
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {thesis.results.map((result) => (
              <tr>
                <td class="px-4 py-3 text-ink">{result.model}</td>
                <td class="px-4 py-3 text-muted">{result.accuracy}</td>
                <td class="px-4 py-3 text-muted">{result.macroF1 ?? "—"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div class="mt-6 border border-dashed border-line px-6 py-10">
        <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-faint">
          Documentation in progress
        </p>
        <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted">{thesis.statusNote}</p>
      </div>
    )}

    <a
      href={thesis.repo}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-6 inline-flex border border-line px-4 py-2 font-mono text-[10px] uppercase tracking-[0.16em] text-muted transition-colors hover:border-mint hover:text-mint"
    >
      Source and figures on GitHub ↗
    </a>
  </section>

  <section class="border-b border-line py-14">
    <h2 class="font-display text-xl font-medium tracking-tight">Limitations</h2>
    <ul class="mt-8 divide-y divide-line border-y border-line">
      {thesis.limitations.map((limitation) => (
        <li class="flex gap-4 py-5">
          <span class="mt-2 h-1 w-1 shrink-0 bg-mint" aria-hidden="true" />
          <p class="max-w-2xl text-sm leading-relaxed text-muted">{limitation}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="flex flex-wrap items-center gap-3 py-14">
    <a
      href="/research"
      class="inline-flex items-center border border-line px-5 py-2.5 font-mono text-[11px] uppercase tracking-[0.16em] text-muted transition-colors hover:border-mint hover:text-mint"
    >
      Research
    </a>
    <a
      href="/projects"
      class="inline-flex items-center px-2 py-2.5 font-mono text-[11px] uppercase tracking-[0.16em] text-faint transition-colors hover:text-mint"
    >
      All projects →
    </a>
  </section>
</MainLayout>
