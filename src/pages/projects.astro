---
import MainLayout from "../layouts/MainLayout.astro";
import PageHero from "../components/PageHero.astro";
import { projects } from "../data/projects";
import { pageCopy } from "../data/pages";
import { site } from "../data/site";

const projectsPage = pageCopy.projectsPage;
---

<MainLayout
  title="Projects"
  description={`Software engineering projects by ${site.name}.`}
>
  <PageHero
    eyebrow={projectsPage.eyebrow}
    title={projectsPage.title}
    description={projectsPage.description}
  />

  <section class="py-10">
    <ul class="grid gap-px border border-line bg-line md:grid-cols-2">
      {projects.map((project) => (
        <li class="bg-canvas">
          <div class="flex h-full flex-col p-6 sm:p-8">
            <p class:list={[
              "font-mono text-[10px] uppercase tracking-[0.18em]",
              project.href ? "text-mint" : "text-faint",
            ]}>
              {project.category}
            </p>
            <h2 class="mt-3 font-display text-xl font-medium tracking-tight text-ink">{project.title}</h2>
            <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{project.summary}</p>
            <p class="mt-5 font-mono text-[10px] uppercase tracking-[0.16em] text-faint">{project.period}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="border border-line px-2 py-0.5 font-mono text-[10px] tracking-[0.1em] text-faint">{tag}</span>
              ))}
            </div>
            <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2">
              {project.href && (
                <a href={project.href} class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted hover:text-mint">
                  {project.linkLabel ?? "Open project"} →
                </a>
              )}
              {project.repo && (
                <a
                  href={project.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint hover:text-mint"
                >
                  GitHub ↗
                </a>
              )}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>
</MainLayout>