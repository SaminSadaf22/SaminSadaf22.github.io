---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Education"
  description="Education of Samin Sadaf — BSc in Software Engineering, Daffodil International University."
>
  <section class="border-b border-line py-14">
    <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-faint">Academic</p>
    <h1 class="mt-5 font-display text-4xl font-medium tracking-tight sm:text-5xl">Education</h1>
  </section>

  <section class="py-14">
    <div class="border border-line bg-card p-6 sm:p-8">
      <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-mint">Bachelor's degree</p>
      <h2 class="mt-3 font-display text-2xl font-medium tracking-tight text-ink">
        BSc in Software Engineering
      </h2>
      <p class="mt-2 text-base text-muted">Daffodil International University · Dhaka, Bangladesh</p>

      <dl class="mt-8 grid gap-px border border-line bg-line sm:grid-cols-3">
        {[
          ["Graduated", "June 2026"],
          ["CGPA", "3.00 / 4.00"],
          ["Thesis", "Corn leaf disease detection"],
        ].map(([term, detail]) => (
          <div class="bg-canvas p-5">
            <dt class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">{term}</dt>
            <dd class="mt-2 text-sm text-ink">{detail}</dd>
          </div>
        ))}
      </dl>

      <p class="mt-8 max-w-2xl text-sm leading-relaxed text-muted">
        My thesis, <em>Corn Leaf Disease Detection Using Deep Learning</em>,
        compared DenseNet121 and EfficientNet-B0 for image-based classification
        of corn leaf disease. It is documented in full on the projects page.
      </p>

      <a
        href="/projects/corn-leaf-disease"
        class="mt-6 inline-flex border border-line px-4 py-2 font-mono text-[10px] uppercase tracking-[0.16em] text-muted hover:border-mint hover:text-mint"
      >
        View the thesis
      </a>
    </div>
  </section>
</MainLayout>