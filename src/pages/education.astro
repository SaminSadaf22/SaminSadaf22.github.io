---
import MainLayout from "../layouts/MainLayout.astro";
import PageHero from "../components/PageHero.astro";
import { resume } from "../data/resume";
import { pageCopy } from "../data/pages";
import { thesis } from "../data/thesis";

const educationPage = pageCopy.educationPage;
const degree = resume.education[0];
const earlier = resume.education.slice(1);
---

<MainLayout
  title="Education"
  description={educationPage.description}
>
  <PageHero
    eyebrow={educationPage.eyebrow}
    title={educationPage.title}
    description={educationPage.description}
  />

  <section class="py-14">
    <div class="border border-line bg-card p-6 sm:p-8">
      <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-mint">Earlier education</p>
      <ul class="mt-6 space-y-6">
        {earlier.map((item) => (
          <li>
            <h2 class="font-display text-xl font-medium tracking-tight text-ink">
              {item.degree}
            </h2>
            <p class="mt-1 text-base text-muted">
              {item.institution} · {item.location}
            </p>
            <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.16em] text-faint">{item.period}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="py-14">
    <div class="border border-line bg-card p-6 sm:p-8">
      <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-mint">Bachelor's degree</p>
      <h2 class="mt-3 font-display text-2xl font-medium tracking-tight text-ink">
        {degree.degree}
      </h2>
      <p class="mt-2 text-base text-muted">{degree.institution} · {degree.location}</p>

      <dl class="mt-8 grid gap-px border border-line bg-line sm:grid-cols-2">
        {[
          ["Graduated", degree.period],
          ["Thesis", thesis.title],
        ].map(([term, detail]) => (
          <div class="bg-canvas p-5">
            <dt class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">{term}</dt>
            <dd class="mt-2 text-sm text-ink">{detail}</dd>
          </div>
        ))}
      </dl>

      <p class="mt-8 max-w-2xl text-sm leading-relaxed text-muted">
        {thesis.shortSummary}
      </p>

      <a
        href="/thesis"
        class="mt-6 inline-flex border border-line px-4 py-2 font-mono text-[10px] uppercase tracking-[0.16em] text-muted hover:border-mint hover:text-mint"
      >
        View the thesis
      </a>
    </div>
  </section>
</MainLayout>
