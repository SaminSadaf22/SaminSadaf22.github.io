---
import MainLayout from "../layouts/MainLayout.astro";
import { site } from "../data/site";
---

<MainLayout
  title="Contact"
  description="Contact Samin Sadaf by email."
>
  <section class="border-b border-line py-14">
    <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-faint">Contact</p>
    <h1 class="mt-5 font-display text-4xl font-medium tracking-tight sm:text-5xl">Say hello</h1>
    <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted">
      Email is the most direct route. I reply to anything specific about the work.
    </p>
  </section>

  <section class="grid gap-px border-b border-line bg-line md:grid-cols-2">
    <div class="bg-canvas p-8">
      <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">Email</p>
      <a
        href={`mailto:${site.email}`}
        class="mt-3 inline-block break-all font-display text-xl font-medium tracking-tight text-ink underline decoration-line underline-offset-4 hover:text-mint"
      >
        {site.email}
      </a>
      <p class="mt-4 text-sm leading-relaxed text-muted">
        Opens your mail client — no form, no third party holding your message.
      </p>
    </div>

    <div class="bg-canvas p-8">
      <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">Elsewhere</p>
      <ul class="mt-3 space-y-2">
        {site.socials.map((social) => (
          <li>
            <a href={social.href} target="_blank" rel="noopener noreferrer" class="text-sm text-muted underline decoration-line underline-offset-4 hover:text-mint">
              {social.label} ↗
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-6 font-mono text-[10px] uppercase tracking-[0.18em] text-faint">Location</p>
      <p class="mt-2 text-sm text-muted">{site.location}</p>
    </div>
  </section>
</MainLayout>