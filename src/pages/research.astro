---
import MainLayout from "../layouts/MainLayout.astro";
import PageHero from "../components/PageHero.astro";
import { researchInterests } from "../data/profile";
import { pageCopy } from "../data/pages";
import { thesis } from "../data/thesis";

const researchPage = pageCopy.researchPage;
---

<MainLayout
  title="Research"
  description="Research by Samin Sadaf on applied deep learning and computer vision for agriculture."
>
  <PageHero
    eyebrow={researchPage.eyebrow}
    title={researchPage.title}
    accent={researchPage.accent}
    description={researchPage.description}
  />

  <section class="border-b border-line py-14">
    <h2 class="font-display text-xl font-medium tracking-tight">Thesis</h2>
    <a href="/thesis" class="group mt-6 block border border-line bg-card p-6 sm:p-8 hover:border-mint/50">
      <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-mint">{thesis.kind} · {thesis.period}</p>
      <h3 class="mt-3 font-display text-2xl font-medium tracking-tight text-ink">
        {thesis.title}
      </h3>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted">
        {thesis.shortSummary}
      </p>
      <span class="mt-6 inline-block font-mono text-[10px] uppercase tracking-[0.18em] text-muted group-hover:text-mint">
        Read the full study →
      </span>
    </a>
  </section>

  <section class="border-b border-line py-14">
    <h2 class="font-display text-xl font-medium tracking-tight">Areas of interest</h2>
    <ul class="mt-8 divide-y divide-line border-y border-line">
      {researchInterests.map((interest) => (
        <li class="grid gap-2 py-6 sm:grid-cols-[240px_1fr] sm:gap-8">
          <h3 class="font-display text-base font-medium tracking-tight text-ink">{interest.title}</h3>
          <p class="text-sm leading-relaxed text-muted">{interest.detail}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="py-14">
    <h2 class="font-display text-xl font-medium tracking-tight">Publications</h2>
    <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted">
      I have no peer-reviewed publications yet. Nothing is listed rather than
      listed aspirationally.
    </p>
    <a href="/publications" class="mt-6 inline-flex border border-line px-4 py-2 font-mono text-[10px] uppercase tracking-[0.16em] text-muted hover:border-mint hover:text-mint">
      Publications
    </a>
  </section>
</MainLayout>